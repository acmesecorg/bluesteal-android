# Copy this file to `local.properties` (gitignored) and fill in real values.
# Android Studio writes `sdk.dir` here automatically the first time you open
# the project; the TURN_* lines below are bluesteal-specific.
#
# To mint TURN credentials, see the root README at
# https://github.com/<owner>/bluesteal#turn-relay-configuration

sdk.dir=/Users/<you>/Library/Android/sdk

# Cloudflare Realtime TURN — short-lived credentials minted from a TURN Key.
# Leave blank to fall back to STUN-only (no TURN relay path).
TURN_USERNAME=
TURN_CREDENTIAL=

# Pairing rendezvous (bluesteal/tools/rendezvous worker) — the out-of-band
# token drop for the "two rooms" demo. Leave blank to disable rendezvous join.
# The base URL and key are NEVER committed (this is why they live here).
rendezvous.baseUrl=
rendezvous.key=
rendezvous.room=
